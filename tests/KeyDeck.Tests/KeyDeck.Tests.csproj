<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>KeyDeck.Tests</RootNamespace>
    <AssemblyName>KeyDeck.Tests</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NuGetAudit>false</NuGetAudit>
    <NoWarn>$(NoWarn);NU1900</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\KeyDeck.Core\KeyDeck.Core.csproj" />
    <ProjectReference Include="..\..\src\KeyDeck.Platform.Linux\KeyDeck.Platform.Linux.csproj" />
    <ProjectReference Include="..\..\src\KeyDeck\KeyDeck.csproj" />
  </ItemGroup>
</Project>
