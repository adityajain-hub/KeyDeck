<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="KeyDeck.UI.Avalonia.Views.NumpadKeyCell"
             Cursor="Hand">
    <Border x:Name="CellBorder"
            Background="#1E1E22"
            BorderBrush="#3F3F46"
            BorderThickness="1"
            CornerRadius="6"
            Margin="3">
        <Grid Margin="6" RowDefinitions="Auto,*,Auto">
            <!-- Physical Key Legend (Top-Left) -->
            <TextBlock x:Name="LegendText"
                       Grid.Row="0"
                       Text="7"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="#A1A1AA"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top" />

            <!-- Action Type Badge (Center) -->
            <Border x:Name="BadgeBorder"
                    Grid.Row="1"
                    Background="#27272A"
                    CornerRadius="4"
                    Padding="6,2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <TextBlock x:Name="ActionBadgeText"
                           Text="NONE"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="#71717A" />
            </Border>

            <!-- Macro Action Label (Bottom) -->
            <TextBlock x:Name="ActionLabelText"
                       Grid.Row="2"
                       Text="(Unassigned)"
                       FontSize="11"
                       TextTrimming="CharacterEllipsis"
                       TextAlignment="Center"
                       Foreground="#F4F4F5"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Bottom"
                       MaxWidth="100" />
        </Grid>
    </Border>
</UserControl>
