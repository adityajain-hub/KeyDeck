<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="KeyDeck.UI.Avalonia.Views.HudWindow"
        Title="KeyDeck HUD"
        Width="300" Height="340"
        SystemDecorations="None"
        Topmost="True"
        ShowInTaskbar="False"
        Background="Transparent">
    <Border x:Name="HudBorder"
            Background="#18181B"
            BorderBrush="#0078D6"
            BorderThickness="1"
            CornerRadius="8"
            Padding="10">
        <Grid RowDefinitions="Auto,*">
            <!-- Header: Title + Profile Name + Close -->
            <Grid Grid.Row="0" Margin="0,0,0,8" ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="KeyDeck HUD"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="#0078D6" />
                    <TextBlock x:Name="ProfileNameText"
                               Text=" (Productivity)"
                               FontSize="11"
                               Foreground="#A1A1AA" />
                </StackPanel>
                <Button x:Name="CloseHudButton"
                        Grid.Column="1"
                        Content="✕"
                        Classes="secondary"
                        Width="20" Height="20"
                        Padding="0"
                        FontSize="10"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Click="OnCloseClicked" />
            </Grid>

            <!-- Compact 4x5 Numpad Grid Display -->
            <Grid x:Name="HudGrid"
                  Grid.Row="1"
                  RowDefinitions="*,*,*,*,*"
                  ColumnDefinitions="*,*,*,*" />
        </Grid>
    </Border>
</Window>
