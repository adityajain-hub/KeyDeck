<UserControl x:Class="KeyDeck.UI.Controls.ProfileListPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="580" d:DesignWidth="230">

    <Border Background="{DynamicResource PanelBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,1,0"
            Padding="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock Grid.Row="0"
                       Text="PROFILES"
                       FontSize="11"
                       FontWeight="Bold"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Margin="0,0,0,10" />

            <!-- Profile List -->
            <ListBox x:Name="ProfilesListBox"
                     Grid.Row="1"
                     SelectionChanged="OnProfileSelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding LinkedProcessName}"
                                       FontSize="10"
                                       Foreground="{DynamicResource AccentBrush}"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LinkedProcessName}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding LinkedProcessName}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Per-App Auto-Profile Switching Box -->
            <Border Grid.Row="2"
                    Background="{DynamicResource CellBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="8"
                    Margin="0,10,0,0">
                <StackPanel>
                    <CheckBox x:Name="AutoSwitchEnabledCheckBox"
                              Content="Auto-Switch by App"
                              FontSize="11"
                              FontWeight="SemiBold"
                              ToolTip="Automatically switch profiles when a linked app window is in the foreground"
                              Margin="0,0,0,6"
                              Checked="OnAutoSwitchCheckBoxChanged"
                              Unchecked="OnAutoSwitchCheckBoxChanged" />

                    <TextBlock Text="Linked App (.exe) for Selected Profile:"
                               FontSize="10"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,0,0,4" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="LinkedAppTextBox"
                                 Grid.Column="0"
                                 FontSize="11"
                                 ToolTip="e.g. Code.exe or obs64.exe"
                                 LostFocus="OnLinkedAppLostFocus"
                                 KeyDown="OnLinkedAppKeyDown" />
                        <Button Grid.Column="1"
                                Content="..."
                                Width="24"
                                Padding="0"
                                Margin="4,0,0,0"
                                ToolTip="Browse for Application (.exe)"
                                Click="OnBrowseLinkedAppClick" />
                        <Button Grid.Column="2"
                                Content="✕"
                                Width="22"
                                Padding="0"
                                Margin="3,0,0,0"
                                ToolTip="Clear Linked App"
                                Click="OnClearLinkedAppClick" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Profile CRUD Buttons -->
            <Grid Grid.Row="3" Margin="0,10,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button x:Name="NewButton"
                        Grid.Row="0" Grid.Column="0"
                        Content="+ New"
                        Margin="0,0,3,4"
                        Click="OnNewProfileClick" />

                <Button x:Name="DuplicateButton"
                        Grid.Row="0" Grid.Column="1"
                        Content="Duplicate"
                        Margin="3,0,0,4"
                        Click="OnDuplicateProfileClick" />

                <Button x:Name="RenameButton"
                        Grid.Row="1" Grid.Column="0"
                        Content="Rename"
                        Margin="0,2,3,0"
                        Click="OnRenameProfileClick" />

                <Button x:Name="DeleteButton"
                        Grid.Row="1" Grid.Column="1"
                        Content="- Delete"
                        Style="{DynamicResource DangerButton}"
                        Margin="3,2,0,0"
                        Click="OnDeleteProfileClick" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
