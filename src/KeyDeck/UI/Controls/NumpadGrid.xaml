<UserControl x:Class="KeyDeck.UI.Controls.NumpadGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KeyDeck.UI.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="420" d:DesignWidth="420">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ROW 0: NumLock Status, Divide, Multiply, Subtract -->
        <Border x:Name="NumLockCell"
                Grid.Row="0" Grid.Column="0"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Margin="3"
                Cursor="Hand"
                MouseLeftButtonDown="OnNumLockCellClicked"
                ToolTip="Shows hardware Num Lock status. Macro pad activates when Num Lock is OFF.">
            <Grid Margin="5">
                <TextBlock Text="NumLock"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top" />
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Ellipse x:Name="NumLockIndicatorDot"
                             Width="8" Height="8"
                             Fill="{DynamicResource AccentBrush}"
                             HorizontalAlignment="Center"
                             Margin="0,0,0,3" />
                    <TextBlock x:Name="NumLockStatusLabel"
                               Text="MACROS ACTIVE"
                               FontSize="9"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <local:NumpadKeyCell x:Name="CellDivide" Grid.Row="0" Grid.Column="1" Legend="/" />
        <local:NumpadKeyCell x:Name="CellMultiply" Grid.Row="0" Grid.Column="2" Legend="*" />
        <local:NumpadKeyCell x:Name="CellSubtract" Grid.Row="0" Grid.Column="3" Legend="-" />

        <!-- ROW 1: 7, 8, 9, Add (RowSpan 2) -->
        <local:NumpadKeyCell x:Name="Cell7" Grid.Row="1" Grid.Column="0" Legend="7" />
        <local:NumpadKeyCell x:Name="Cell8" Grid.Row="1" Grid.Column="1" Legend="8" />
        <local:NumpadKeyCell x:Name="Cell9" Grid.Row="1" Grid.Column="2" Legend="9" />
        <local:NumpadKeyCell x:Name="CellAdd" Grid.Row="1" Grid.Column="3" Grid.RowSpan="2" Legend="+" />

        <!-- ROW 2: 4, 5, 6 -->
        <local:NumpadKeyCell x:Name="Cell4" Grid.Row="2" Grid.Column="0" Legend="4" />
        <local:NumpadKeyCell x:Name="Cell5" Grid.Row="2" Grid.Column="1" Legend="5" />
        <local:NumpadKeyCell x:Name="Cell6" Grid.Row="2" Grid.Column="2" Legend="6" />

        <!-- ROW 3: 1, 2, 3, Enter (RowSpan 2) -->
        <local:NumpadKeyCell x:Name="Cell1" Grid.Row="3" Grid.Column="0" Legend="1" />
        <local:NumpadKeyCell x:Name="Cell2" Grid.Row="3" Grid.Column="1" Legend="2" />
        <local:NumpadKeyCell x:Name="Cell3" Grid.Row="3" Grid.Column="2" Legend="3" />
        <local:NumpadKeyCell x:Name="CellEnter" Grid.Row="3" Grid.Column="3" Grid.RowSpan="2" Legend="Enter" />

        <!-- ROW 4: 0 (ColSpan 2), Decimal -->
        <local:NumpadKeyCell x:Name="Cell0" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Legend="0" />
        <local:NumpadKeyCell x:Name="CellDecimal" Grid.Row="4" Grid.Column="2" Legend="." />

    </Grid>
</UserControl>
