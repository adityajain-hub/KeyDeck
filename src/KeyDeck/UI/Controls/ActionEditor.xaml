<UserControl x:Class="KeyDeck.UI.Controls.ActionEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:KeyDeck.UI.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="760" d:DesignWidth="350">

    <UserControl.Resources>
        <converters:ActionTypeToDisplayNameConverter x:Key="ActionTypeConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <DataTemplate x:Key="EnumDisplayTemplate">
            <TextBlock Text="{Binding Converter={StaticResource ActionTypeConverter}}" />
        </DataTemplate>
    </UserControl.Resources>

    <Border Background="{DynamicResource PanelBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1,0,0,0"
            Padding="14">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- Title Header -->
                <TextBlock x:Name="HeaderTitle"
                           Text="CONFIGURE: NUMPAD 7"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Margin="0,0,0,14" />

                <!-- Action Type Selector -->
                <TextBlock Text="Action Type"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           Margin="0,0,0,5" />
                <ComboBox x:Name="ActionTypeComboBox"
                          ItemTemplate="{StaticResource EnumDisplayTemplate}"
                          Margin="0,0,0,14"
                          SelectionChanged="OnActionTypeChanged" />

                <!-- Action Label -->
                <TextBlock Text="Display Label"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           Margin="0,0,0,5" />
                <TextBox x:Name="LabelTextBox"
                         Margin="0,0,0,14"
                         TextChanged="OnInputChanged" />

                <!-- DYNAMIC CONFIG PANELS -->

                <!-- 1. Launch App Panel -->
                <StackPanel x:Name="LaunchAppPanel" Visibility="Collapsed" Margin="0,0,0,14">
                    <TextBlock Text="Application Executable (.exe)"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Margin="0,0,0,5" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="AppPathTextBox" Grid.Column="0" TextChanged="OnInputChanged" />
                        <Button Grid.Column="1" Content="Browse..." Margin="6,0,0,0" Click="OnBrowseAppClick" />
                    </Grid>
                    <TextBlock Text="Arguments (Optional)"
                               FontSize="11"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,0,0,3" />
                    <TextBox x:Name="AppArgsTextBox" TextChanged="OnInputChanged" />
                </StackPanel>

                <!-- 2. Open URL Panel -->
                <StackPanel x:Name="OpenUrlPanel" Visibility="Collapsed" Margin="0,0,0,14">
                    <TextBlock Text="Webpage URL"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Margin="0,0,0,5" />
                    <TextBox x:Name="UrlTextBox"
                             ToolTip="e.g. https://github.com or google.com"
                             TextChanged="OnInputChanged" />
                </StackPanel>

                <!-- 3. Open Folder Panel -->
                <StackPanel x:Name="OpenFolderPanel" Visibility="Collapsed" Margin="0,0,0,14">
                    <TextBlock Text="Folder Path"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Margin="0,0,0,5" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="FolderPathTextBox" Grid.Column="0" TextChanged="OnInputChanged" />
                        <Button Grid.Column="1" Content="Browse..." Margin="6,0,0,0" Click="OnBrowseFolderClick" />
                    </Grid>
                </StackPanel>

                <!-- 4. Hotkey Panel -->
                <StackPanel x:Name="HotkeyPanel" Visibility="Collapsed" Margin="0,0,0,14">
                    <TextBlock Text="Keyboard Shortcut"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Margin="0,0,0,5" />
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="HotkeyTextBox"
                                 Grid.Column="0"
                                 IsReadOnly="True"
                                 Text="Click to record hotkey..."
                                 PreviewKeyDown="OnHotkeyPreviewKeyDown"
                                 GotFocus="OnHotkeyGotFocus"
                                 LostFocus="OnHotkeyLostFocus"
                                 Cursor="Hand" />
                        <Button Grid.Column="1" Content="Clear" Margin="6,0,0,0" Click="OnClearHotkeyClick" />
                    </Grid>
                    <TextBlock Text="Focus box and press any key combination (e.g. Ctrl + Shift + M)"
                               FontSize="10"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>

                <!-- 5. Run Script Panel -->
                <StackPanel x:Name="RunScriptPanel" Visibility="Collapsed" Margin="0,0,0,14">
                    <TextBlock Text="Script File (.ps1 / .bat / .cmd)"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Margin="0,0,0,5" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ScriptPathTextBox" Grid.Column="0" TextChanged="OnInputChanged" />
                        <Button Grid.Column="1" Content="Browse..." Margin="6,0,0,0" Click="OnBrowseScriptClick" />
                    </Grid>
                    <TextBlock Text="Arguments (Optional)"
                               FontSize="11"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,0,0,3" />
                    <TextBox x:Name="ScriptArgsTextBox" TextChanged="OnInputChanged" />
                </StackPanel>

                <!-- 6. Media Control Panel -->
                <StackPanel x:Name="MediaControlPanel" Visibility="Collapsed" Margin="0,0,0,14">
                    <TextBlock Text="Media Command"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Margin="0,0,0,5" />
                    <ComboBox x:Name="MediaCommandComboBox"
                              ItemTemplate="{StaticResource EnumDisplayTemplate}"
                              SelectionChanged="OnInputChanged" />
                </StackPanel>

                <!-- 7. System Action Panel -->
                <StackPanel x:Name="SystemActionPanel" Visibility="Collapsed" Margin="0,0,0,14">
                    <TextBlock Text="System Command"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Margin="0,0,0,5" />
                    <ComboBox x:Name="SystemCommandComboBox"
                              ItemTemplate="{StaticResource EnumDisplayTemplate}"
                              SelectionChanged="OnInputChanged" />
                </StackPanel>

                <!-- 8. Text Paste Panel -->
                <StackPanel x:Name="TextPastePanel" Visibility="Collapsed" Margin="0,0,0,14">
                    <TextBlock Text="Text to Paste"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Margin="0,0,0,5" />
                    <TextBox x:Name="TextPasteTextBox"
                             AcceptsReturn="True"
                             Height="80"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             TextChanged="OnInputChanged" />
                </StackPanel>

                <!-- 9. Multi Action Panel (with ▲/▼ Reorder & Inline Sub-Action Editor Card) -->
                <StackPanel x:Name="MultiActionPanel" Visibility="Collapsed" Margin="0,0,0,14">
                    <TextBlock Text="Chained Sub-Actions"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Margin="0,0,0,5" />
                    <ListBox x:Name="SubActionsListBox"
                             Height="110"
                             Margin="0,0,0,6"
                             SelectionChanged="OnSubActionSelectionChanged" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="+ Add Step" Margin="0,0,3,0" Click="OnAddSubActionClick" />
                        <Button x:Name="MoveSubActionUpButton" Grid.Column="1" Content="▲" Padding="0" Margin="2,0" ToolTip="Move Step Up" Click="OnMoveSubActionUpClick" />
                        <Button x:Name="MoveSubActionDownButton" Grid.Column="2" Content="▼" Padding="0" Margin="2,0" ToolTip="Move Step Down" Click="OnMoveSubActionDownClick" />
                        <Button x:Name="RemoveSubActionButton" Grid.Column="3" Content="− Remove" Margin="3,0,0,0" Click="OnRemoveSubActionClick" />
                    </Grid>

                    <!-- Inline Sub-Action Editor Card -->
                    <Border x:Name="SubActionEditorCard"
                            Visibility="Collapsed"
                            Background="{DynamicResource CellBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10"
                            Margin="0,2,0,0">
                        <StackPanel>
                            <TextBlock x:Name="SubActionEditorHeader"
                                       Text="EDIT STEP #1"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Margin="0,0,0,8" />

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="85" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="Step Action Type" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,3" />
                                    <ComboBox x:Name="SubActionTypeComboBox"
                                              ItemTemplate="{StaticResource EnumDisplayTemplate}"
                                              SelectionChanged="OnSubActionFieldChanged" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Delay After (ms)" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,3" />
                                    <TextBox x:Name="SubActionDelayTextBox"
                                             Text="150"
                                             TextChanged="OnSubActionFieldChanged" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Step Label" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,3" />
                            <TextBox x:Name="SubActionLabelTextBox"
                                     Margin="0,0,0,8"
                                     TextChanged="OnSubActionFieldChanged" />

                            <!-- Dynamic Sub-Action Target Row (LaunchApp / OpenUrl / OpenFolder / RunScript) -->
                            <StackPanel x:Name="SubActionTargetRow" Visibility="Collapsed" Margin="0,0,0,6">
                                <TextBlock x:Name="SubActionTargetHeader" Text="Target Path / URL" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,3" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="SubActionTargetTextBox" Grid.Column="0" TextChanged="OnSubActionFieldChanged" />
                                    <Button x:Name="SubActionBrowseButton" Grid.Column="1" Content="..." Width="28" Padding="0" Margin="4,0,0,0" Click="OnSubActionBrowseClick" />
                                </Grid>
                            </StackPanel>

                            <StackPanel x:Name="SubActionArgsRow" Visibility="Collapsed" Margin="0,0,0,6">
                                <TextBlock Text="Arguments (Optional)" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,3" />
                                <TextBox x:Name="SubActionArgsTextBox" TextChanged="OnSubActionFieldChanged" />
                            </StackPanel>

                            <!-- Sub-Action Hotkey Row -->
                            <StackPanel x:Name="SubActionHotkeyRow" Visibility="Collapsed" Margin="0,0,0,6">
                                <TextBlock Text="Shortcut to Fire" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,3" />
                                <TextBox x:Name="SubActionHotkeyTextBox"
                                         IsReadOnly="True"
                                         Text="Click &amp; press shortcut..."
                                         PreviewKeyDown="OnSubActionHotkeyPreviewKeyDown"
                                         GotFocus="OnHotkeyGotFocus"
                                         LostFocus="OnSubActionHotkeyLostFocus"
                                         Cursor="Hand" />
                            </StackPanel>

                            <!-- Sub-Action Media Row -->
                            <StackPanel x:Name="SubActionMediaRow" Visibility="Collapsed" Margin="0,0,0,6">
                                <TextBlock Text="Media Command" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,3" />
                                <ComboBox x:Name="SubActionMediaComboBox"
                                          ItemTemplate="{StaticResource EnumDisplayTemplate}"
                                          SelectionChanged="OnSubActionFieldChanged" />
                            </StackPanel>

                            <!-- Sub-Action System Row -->
                            <StackPanel x:Name="SubActionSystemRow" Visibility="Collapsed" Margin="0,0,0,6">
                                <TextBlock Text="System Command" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,3" />
                                <ComboBox x:Name="SubActionSystemComboBox"
                                          ItemTemplate="{StaticResource EnumDisplayTemplate}"
                                          SelectionChanged="OnSubActionFieldChanged" />
                            </StackPanel>

                            <!-- Sub-Action TextPaste Row -->
                            <StackPanel x:Name="SubActionTextPasteRow" Visibility="Collapsed" Margin="0,0,0,6">
                                <TextBlock Text="Text to Paste" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,3" />
                                <TextBox x:Name="SubActionTextPasteBox"
                                         AcceptsReturn="True"
                                         Height="54"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         TextChanged="OnSubActionFieldChanged" />
                            </StackPanel>

                            <!-- Sub-Action SwitchProfile Row -->
                            <StackPanel x:Name="SubActionSwitchProfileRow" Visibility="Collapsed" Margin="0,0,0,4">
                                <TextBlock Text="Target Profile" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,3" />
                                <ComboBox x:Name="SubActionProfileComboBox"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Id"
                                          SelectionChanged="OnSubActionFieldChanged" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 10. Switch Profile Panel -->
                <StackPanel x:Name="SwitchProfilePanel" Visibility="Collapsed" Margin="0,0,0,14">
                    <TextBlock Text="Target Profile to Activate"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Margin="0,0,0,5" />
                    <ComboBox x:Name="TargetProfileComboBox"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Id"
                              SelectionChanged="OnTargetProfileChanged" />
                    <TextBlock Text="Pressing this numpad key switches your active KeyDeck profile immediately."
                               FontSize="10"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,5,0,0" />
                </StackPanel>

                <!-- Icon Settings -->
                <TextBlock Text="Custom Icon"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           Margin="0,4,0,5" />
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Width="30" Height="30"
                            Background="{DynamicResource InputBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3"
                            HorizontalAlignment="Left">
                        <Image x:Name="IconPreview" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Button Grid.Column="1" Content="Browse Icon..." Margin="6,0,4,0" Click="OnBrowseIconClick" />
                    <Button Grid.Column="2" Content="Reset" Click="OnResetIconClick" />
                </Grid>

                <Separator Background="{DynamicResource BorderBrush}" Margin="0,0,0,16" />

                <!-- Action Execution Buttons -->
                <Button x:Name="TestActionButton"
                        Content="▶ Test Action"
                        Style="{DynamicResource AccentButton}"
                        Height="32"
                        Margin="0,0,0,8"
                        Click="OnTestActionClick" />

                <Button x:Name="ClearKeyButton"
                        Content="🗑 Clear Key"
                        Height="28"
                        Click="OnClearKeyClick" />

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
