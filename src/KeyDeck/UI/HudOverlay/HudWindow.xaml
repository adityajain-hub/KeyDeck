<Window x:Class="KeyDeck.UI.HudOverlay.HudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KeyDeck HUD"
        Width="264" Height="340"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        MouseLeftButtonDown="OnWindowMouseLeftButtonDown">

    <Border x:Name="HudContainer"
            Background="#EE1E1E1E"
            BorderBrush="#55555C"
            BorderThickness="1"
            CornerRadius="8"
            Padding="8"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="2,0,2,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="ProfileNameText"
                               Text="Productivity"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="#E0E0E0"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="DragHintBadge"
                               Text=" ✥ DRAG"
                               FontSize="9"
                               FontWeight="Bold"
                               Foreground="#FFB900"
                               Visibility="Collapsed"
                               Margin="6,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="DECK"
                           FontSize="9"
                           FontWeight="Bold"
                           Foreground="#0078D4"
                           VerticalAlignment="Center"
                           Margin="0,0,4,0" />

                <!-- Close / Disable HUD button (visible when HUD is unlocked) -->
                <Button x:Name="HudCloseButton"
                        Grid.Column="2"
                        Content="✕"
                        Width="18"
                        Height="18"
                        Padding="0"
                        FontSize="9"
                        FontWeight="Bold"
                        ToolTip="Hide HUD Overlay"
                        Visibility="Collapsed"
                        Click="OnHudCloseButtonClick" />
            </Grid>

            <!-- 4x5 Mini Stream-Deck Numpad Grid (populated dynamically with Icon + Label cells) -->
            <Grid x:Name="GridContainer" Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Row 0, Col 0: NumLock Indicator -->
                <Border x:Name="MiniNumLock" Grid.Row="0" Grid.Column="0" Background="#252528" BorderBrush="#3A3A3F" BorderThickness="1" CornerRadius="4" Margin="2">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Ellipse x:Name="MiniNumLockDot" Width="6" Height="6" Fill="#0078D4" Margin="0,0,0,2" />
                        <TextBlock Text="NumLk" FontSize="8" FontWeight="SemiBold" Foreground="#999999" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
