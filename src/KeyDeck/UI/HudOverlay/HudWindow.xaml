<Window x:Class="KeyDeck.UI.HudOverlay.HudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KeyDeck HUD"
        Width="230" Height="290"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <Border x:Name="HudContainer"
            Background="#EE1E1E1E"
            BorderBrush="#55555C"
            BorderThickness="1"
            CornerRadius="8"
            Padding="8"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="2,0,2,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="ProfileNameText"
                           Grid.Column="0"
                           Text="Productivity"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="#E0E0E0"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />

                <TextBlock Grid.Column="1"
                           Text="DECK"
                           FontSize="9"
                           FontWeight="Bold"
                           Foreground="#0078D4"
                           VerticalAlignment="Center" />
            </Grid>

            <!-- 4x5 Mini Numpad Grid -->
            <Grid x:Name="GridContainer" Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Row 0 -->
                <Border x:Name="MiniNumLock" Grid.Row="0" Grid.Column="0" Background="#28282B" CornerRadius="3" Margin="2">
                    <TextBlock Text="NumLk" FontSize="8" Foreground="#888888" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border x:Name="MiniDivide" Grid.Row="0" Grid.Column="1" Background="#2D2D30" CornerRadius="3" Margin="2">
                    <TextBlock x:Name="TextDivide" Text="/" FontSize="9" Foreground="#CCCCCC" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Border>
                <Border x:Name="MiniMultiply" Grid.Row="0" Grid.Column="2" Background="#2D2D30" CornerRadius="3" Margin="2">
                    <TextBlock x:Name="TextMultiply" Text="*" FontSize="9" Foreground="#CCCCCC" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Border>
                <Border x:Name="MiniSubtract" Grid.Row="0" Grid.Column="3" Background="#2D2D30" CornerRadius="3" Margin="2">
                    <TextBlock x:Name="TextSubtract" Text="-" FontSize="9" Foreground="#CCCCCC" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Border>

                <!-- Row 1 -->
                <Border x:Name="Mini7" Grid.Row="1" Grid.Column="0" Background="#2D2D30" CornerRadius="3" Margin="2">
                    <TextBlock x:Name="Text7" Text="7" FontSize="9" Foreground="#CCCCCC" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Border>
                <Border x:Name="Mini8" Grid.Row="1" Grid.Column="1" Background="#2D2D30" CornerRadius="3" Margin="2">
                    <TextBlock x:Name="Text8" Text="8" FontSize="9" Foreground="#CCCCCC" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Border>
                <Border x:Name="Mini9" Grid.Row="1" Grid.Column="2" Background="#2D2D30" CornerRadius="3" Margin="2">
                    <TextBlock x:Name="Text9" Text="9" FontSize="9" Foreground="#CCCCCC" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Border>
                <Border x:Name="MiniAdd" Grid.Row="1" Grid.Column="3" Grid.RowSpan="2" Background="#2D2D30" CornerRadius="3" Margin="2">
                    <TextBlock x:Name="TextAdd" Text="+" FontSize="9" Foreground="#CCCCCC" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Border>

                <!-- Row 2 -->
                <Border x:Name="Mini4" Grid.Row="2" Grid.Column="0" Background="#2D2D30" CornerRadius="3" Margin="2">
                    <TextBlock x:Name="Text4" Text="4" FontSize="9" Foreground="#CCCCCC" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Border>
                <Border x:Name="Mini5" Grid.Row="2" Grid.Column="1" Background="#2D2D30" CornerRadius="3" Margin="2">
                    <TextBlock x:Name="Text5" Text="5" FontSize="9" Foreground="#CCCCCC" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Border>
                <Border x:Name="Mini6" Grid.Row="2" Grid.Column="2" Background="#2D2D30" CornerRadius="3" Margin="2">
                    <TextBlock x:Name="Text6" Text="6" FontSize="9" Foreground="#CCCCCC" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Border>

                <!-- Row 3 -->
                <Border x:Name="Mini1" Grid.Row="3" Grid.Column="0" Background="#2D2D30" CornerRadius="3" Margin="2">
                    <TextBlock x:Name="Text1" Text="1" FontSize="9" Foreground="#CCCCCC" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Border>
                <Border x:Name="Mini2" Grid.Row="3" Grid.Column="1" Background="#2D2D30" CornerRadius="3" Margin="2">
                    <TextBlock x:Name="Text2" Text="2" FontSize="9" Foreground="#CCCCCC" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Border>
                <Border x:Name="Mini3" Grid.Row="3" Grid.Column="2" Background="#2D2D30" CornerRadius="3" Margin="2">
                    <TextBlock x:Name="Text3" Text="3" FontSize="9" Foreground="#CCCCCC" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Border>
                <Border x:Name="MiniEnter" Grid.Row="3" Grid.Column="3" Grid.RowSpan="2" Background="#2D2D30" CornerRadius="3" Margin="2">
                    <TextBlock x:Name="TextEnter" Text="Enter" FontSize="9" Foreground="#CCCCCC" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Border>

                <!-- Row 4 -->
                <Border x:Name="Mini0" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Background="#2D2D30" CornerRadius="3" Margin="2">
                    <TextBlock x:Name="Text0" Text="0" FontSize="9" Foreground="#CCCCCC" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Border>
                <Border x:Name="MiniDecimal" Grid.Row="4" Grid.Column="2" Background="#2D2D30" CornerRadius="3" Margin="2">
                    <TextBlock x:Name="TextDecimal" Text="." FontSize="9" Foreground="#CCCCCC" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Border>

            </Grid>
        </Grid>
    </Border>
</Window>
